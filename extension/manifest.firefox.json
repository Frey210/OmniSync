{
  "manifest_version": 2,
  "name": "OmniSync",
  "version": "1.0",
  "description": "Cross-Platform Anime & Manga Tracker",

  "browser_specific_settings": {
    "gecko": {
      "id": "omnisync@farlabs.my.id",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms",
    "https://api.farlabs.my.id/*",
    "*://komiku.id/*",
    "*://11.shinigami.asia/*",
    "*://mangafire.to/*",
    "*://*.ylnime.com/*",
    "*://ylnime.com/*",
    "*://*.animesail.xyz/*",
    "*://*.otakudesu.blog/*",
    "*://otakudesu.blog/*",
    "*://*.gogoanime.com/*",
    "*://*.gogoanime.pe/*",
    "*://*.anitaku.to/*",
    "*://hstream.moe/*",
    "*://*.hstream.moe/*",
    "*://hanime.tv/*"
  ],

  "background": {
    "scripts": ["utils/browser-polyfill.js", "utils/auth.js", "utils/api.js", "background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": [
        "*://komiku.id/*",
        "*://11.shinigami.asia/*",
        "*://mangafire.to/*"
      ],
      "js": ["utils/browser-polyfill.js", "content/manga-tracker.js"]
    },
    {
      "matches": [
        "*://ylnime.com/*",
        "*://*.ylnime.com/*",
        "*://*.animesail.xyz/*",
        "*://otakudesu.blog/*",
        "*://*.otakudesu.blog/*",
        "*://*.gogoanime.com/*",
        "*://*.gogoanime.pe/*",
        "*://*.anitaku.to/*",
        "*://hstream.moe/*",
        "*://*.hstream.moe/*",
        "*://hanime.tv/*"
      ],
      "js": ["utils/browser-polyfill.js", "content/anime-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://api.farlabs.my.id/api/anilist-callback*"],
      "js": ["utils/browser-polyfill.js", "content/auth-callback.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": ["icons/*", "utils/*"]
}
