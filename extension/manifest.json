{
  "manifest_version": 3,
  "name": "OmniSync",
  "version": "1.0",
  "description": "Cross-Platform Anime & Manga Tracker",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "*://komiku.id/*",
    "*://11.shinigami.asia/*",
    "*://mangafire.to/*",
    "*://ylnime.com/*",
    "*://v1.animesail.xyz/*",
    "*://otakudesu.blog/*",
    "*://*.gogoanime.com/*",
    "*://*.gogoanime.pe/*",
    "*://*.anitaku.to/*",
    "https://api.farlabs.my.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://komiku.id/*",
        "*://11.shinigami.asia/*",
        "*://mangafire.to/*"
      ],
      "js": ["content/manga-tracker.js"]
    },
    {
      "matches": [
        "*://ylnime.com/*",
        "*://v1.animesail.xyz/*",
        "*://otakudesu.blog/*",
        "*://*.gogoanime.com/*",
        "*://*.gogoanime.pe/*",
        "*://*.anitaku.to/*"
      ],
      "js": ["content/anime-tracker.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
